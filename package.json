{
  "name": "resillo-native",
  "version": "1.0.0",
  "private": true,
  "description": "Native desktop and Android shells for the ResillO triage dashboard",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "android:add": "node scripts/prepare-mobile.cjs && cap add android",
    "android:sync": "node scripts/prepare-mobile.cjs && cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "electron": "^38.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0"
  }
}
